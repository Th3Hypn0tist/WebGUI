{
  "name": "WebGUI",
  "version": "0.1.0",
  "kind": "standalone structural DOM framework",
  "runtime": "browser",
  "principles": [
    "concept-free",
    "minimal DOM construction and structural rendering",
    "all stateful functionality is instantiable",
    "no host application dependencies",
    "no browser globals are registered",
    "one public JavaScript entry point exists at the repository root",
    "themes are selected by instance configuration"
  ],
  "mustNot": [
    "contain host-domain concepts",
    "depend on another framework",
    "contain application state management",
    "copy or mutate consumer-owned themes",
    "accept implicit unsafe HTML"
  ]
}
